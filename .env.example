# =============================================
# S'Connect — Environment variables (template)
# Copy to .env.local and fill in.
# =============================================

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://www.sconnect-france.fr

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=contact@sconnect-france.fr
RESEND_TO_EMAIL=contact@sconnect-france.fr

# --- Auth ---
JWT_SECRET=change-me-to-a-32-char-random-string

# --- Optional analytics / monitoring ---
NEXT_PUBLIC_GA_ID=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- SEO verification ---
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# --- Optional integrations ---
WHATSAPP_NUMBER=
BREVO_API_KEY=
RESEND_AUDIENCE_ID=

# --- Maintenance toggle ---
MAINTENANCE_MODE=false
