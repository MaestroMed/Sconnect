# =====================================================================
# S Connect France — variables d'environnement (template CANONIQUE)
# Copier vers .env.local et remplir. C'est le SEUL template qui fait foi
# (les anciens .env.local.example / env.example.txt ont été supprimés —
# ils divergeaient, et celui-ci documentait le MAUVAIS domaine
# sconnect-france.fr : la version avec tiret n'héberge ni le site ni le mail).
# =====================================================================

# --- Site ---
# Domaine canonique : sconnectfrance.fr (SANS tiret, sans www)
NEXT_PUBLIC_SITE_URL=https://sconnectfrance.fr

# --- Supabase (admin, soumissions, newsletter) ---
# ⚠️ Si le projet Supabase est mort/en pause, laisser VIDE plutôt que de
# pointer vers un projet injoignable. Le blog (MDX) ne dépend PAS de la base.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (emails devis / contact / intervention) ---
# RESEND_FROM_EMAIL : le domaine DOIT être vérifié dans le dashboard Resend,
# sinon TOUS les envois échouent (et les leads ne partent que vers Supabase).
RESEND_API_KEY=
RESEND_FROM_EMAIL=contact@sconnectfrance.fr
RESEND_TO_EMAIL=contact@sconnectfrance.fr

# --- Auth admin ---
# OBLIGATOIRE en production : >= 32 caractères aléatoires. Sans lui, l'auth
# admin est désactivée (fail-closed). Générer : openssl rand -base64 48
JWT_SECRET=

# --- Coordonnées affichées (emails transactionnels, schema.org) ---
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_PHONE_EMERGENCY=

# --- Analytics (GA4, chargé uniquement après consentement cookies) ---
# ID de mesure G-XXXXXXXXXX — lu par AnalyticsGate. Les anciens
# NEXT_PUBLIC_GA_ID / NEXT_PUBLIC_GTM_ID ne sont plus lus par le code.
NEXT_PUBLIC_GA4_ID=

# --- Monitoring (optionnel — Sentry inactif si non rempli) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Taux d'échantillonnage des traces (0-1, défaut 0.1). Variante
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE pour le client.
SENTRY_TRACES_SAMPLE_RATE=

# --- SEO verification (optionnel) ---
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# --- SEO local programmatique ---
# Population minimale pour publier une page commune (défaut dans le code).
NEXT_PUBLIC_LOCALSEO_MIN_POP=

# --- IndexNow ---
INDEXNOW_KEY=
# Jeton exigé par POST /api/indexnow (déclenchement manuel des pings).
INDEXNOW_TRIGGER_TOKEN=

# --- Maintenance toggle ---
MAINTENANCE_MODE=false
