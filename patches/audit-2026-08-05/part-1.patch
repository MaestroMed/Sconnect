+// Types d'images autorisés : le MIME est vérifié par MAGIC BYTES (le
+// file.type envoyé par le client est falsifiable) et le Content-Type stocké
+// est celui détecté, pas celui déclaré.
+const ALLOWED_IMAGE_TYPES: Record<string, { ext: string; magic: (b: Buffer) => boolean }> = {
+  'image/jpeg': { ext: 'jpg', magic: (b) => b.length > 2 && b[0] === 0xff && b[1] === 0xd8 && b[2] === 0xff },
+  'image/png': { ext: 'png', magic: (b) => b.length > 7 && b.readUInt32BE(0) === 0x89504e47 },
+  'image/webp': {
+    ext: 'webp',
+    magic: (b) => b.length > 11 && b.toString('ascii', 0, 4) === 'RIFF' && b.toString('ascii', 8, 12) === 'WEBP',
+  },
+  'image/gif': { ext: 'gif', magic: (b) => b.length > 5 && ['GIF87a', 'GIF89a'].includes(b.toString('ascii', 0, 6)) },
+  'image/svg+xml': {
+    ext: 'svg',
+    // SVG = XML texte : présence d'une balise <svg dans les premiers Ko.
+    magic: (b) => b.slice(0, 4096).toString('utf8').toLowerCase().includes('<svg'),
+  },
+}
+
+function detectImageType(buffer: Buffer): { mime: string; ext: string } | null {
+  for (const [mime, { ext, magic }] of Object.entries(ALLOWED_IMAGE_TYPES)) {
+    if (magic(buffer)) return { mime, ext }
+  }
+  return null
+}
+
+// Dossiers de destination whitelistés — `folder` vient du formulaire client.
+const ALLOWED_FOLDERS = new Set([
+  'general', 'logos', 'hero', 'services', 'realizations', 'brands',
+  'testimonials', 'media', 'posts',
+])
 
