{
  "name": "sconnect-france",
  "version": "1.0.0",
  "description": "Site vitrine S Connect France - Installation électrique en Île-de-France",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "analyze": "ANALYZE=true next build",
    "perf:lh": "npx lighthouse http://localhost:3000 --output=html --output-path=./lighthouse-report.html --view --preset=desktop --throttling-method=devtools",
    "perf:lh:mobile": "npx lighthouse http://localhost:3000 --output=html --output-path=./lighthouse-mobile.html --view",
    "seo:generate": "tsx scripts/seo-generate.ts",
    "seo:generate:dry": "tsx scripts/seo-generate.ts -- --dry",
    "seo:refresh-dates": "tsx scripts/refresh-dates.ts",
    "seo:refresh-dates:dry": "tsx scripts/refresh-dates.ts -- --dry",
    "db:seed": "tsx scripts/migrate-json-to-supabase.ts",
    "db:import-mdx": "tsx scripts/import-mdx-to-db.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "assets:fetch": "tsx scripts/fetch-images.ts",
    "assets:fetch:force": "tsx scripts/fetch-images.ts --force",
    "brand:favicons": "tsx scripts/generate-favicons.ts",
    "brand:og": "tsx scripts/generate-og-image.ts"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-email/components": "^1.0.6",
    "@sentry/nextjs": "^10.49.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.87.1",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-image": "^3.22.3",
    "@tiptap/extension-link": "^3.22.3",
    "@tiptap/extension-placeholder": "^3.22.3",
    "@tiptap/pm": "^3.22.3",
    "@tiptap/react": "^3.22.3",
    "@tiptap/starter-kit": "^3.22.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^1.1.1",
    "framer-motion": "^11.12.0",
    "gray-matter": "^4.0.3",
    "isomorphic-dompurify": "^3.9.0",
    "js-cookie": "^3.0.5",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.460.0",
    "next": "^15.0.3",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-email": "^5.2.5",
    "react-hook-form": "^7.68.0",
    "reading-time": "^1.5.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.15",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^13.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.4",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.9.3",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.4",
    "dotenv": "^16.4.5",
    "eslint": "^9",
    "eslint-config-next": "^15.5.7",
    "jsdom": "^29.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.4"
  }
}
